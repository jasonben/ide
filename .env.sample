# Optional: copy to .env to override the Rakefile defaults.
# Variables already set in your shell take precedence over this file.

# Image to build and tag (include a registry prefix if you push elsewhere)
IDE_DOCKER_IMAGE=jasonben/ide

# Registry cache that CI pushes, one per architecture ($IDE_CACHE_REF-amd64
# and -arm64); local builds pull layers from it. Set to "none" to build without it.
# IDE_CACHE_REF=jasonben/ide:buildcache
