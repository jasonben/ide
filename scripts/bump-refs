#!/usr/bin/env bash
# Bump the pinned dependency refs in the Dockerfile to their latest upstream
# versions. Reads the same "# renovate: ..." annotations Renovate uses, so the
# two never drift apart. Also bumps DuckDB (version + sha256s), which Renovate
# can't, and keeps the vim-plug URL in dotfiles/nvim/init.lua in step.
#
# usage: scripts/bump-refs [-n|--dry-run] [NAME...]
#   NAME  only bump these ARGs (e.g. TPM_REF DUCKDB1_VERSION); default: all
#
# Needs: git, curl, jq. Set GITHUB_TOKEN to avoid GitHub API rate limits.
set -euo pipefail

root=$(cd "$(dirname "$0")/.." && pwd)
dockerfile="$root/Dockerfile"
init_lua="$root/dotfiles/nvim/init.lua"

dry_run=false
only=()
for arg in "$@"; do
  case "$arg" in
    -n | --dry-run) dry_run=true ;;
    -h | --help) sed -n '2,10p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    -*) echo "unknown option: $arg" >&2; exit 64 ;;
    *) only+=("$arg") ;;
  esac
done

for cmd in git curl jq; do
  command -v "$cmd" >/dev/null || { echo "bump-refs: missing $cmd" >&2; exit 1; }
done

wanted() {
  [ "${#only[@]}" -eq 0 ] && return 0
  local n
  for n in "${only[@]}"; do [ "$n" = "$1" ] && return 0; done
  return 1
}

github_api() {
  local auth=()
  [ -n "${GITHUB_TOKEN:-}" ] && auth=(-H "Authorization: Bearer $GITHUB_TOKEN")
  curl -fsSL "${auth[@]}" -H "Accept: application/vnd.github+json" "https://api.github.com/$1"
}

# Latest plain release tag (1.2.3 or v1.2.3; no pre-releases), keeping the
# current tag's "v" prefix style.
latest_github_tag() {
  local repo=$1 current=$2 prefix=""
  [[ "$current" == v* ]] && prefix="v"
  git ls-remote --tags --refs "https://github.com/$repo.git" |
    awk -F/ '{print $3}' |
    grep -E "^${prefix}[0-9]+(\.[0-9]+)*$" |
    sort -V | tail -1
}

latest_branch_sha() {
  git ls-remote "$1" "refs/heads/$2" | cut -f1
}

latest_docker_tag() {
  local image=$1
  [[ "$image" == */* ]] || image="library/$image"
  curl -fsSL "https://hub.docker.com/v2/repositories/$image/tags?page_size=100&ordering=last_updated" |
    jq -r '.results[].name' |
    grep -E '^[0-9]+\.[0-9]+\.[0-9]+$' |
    sort -V | tail -1
}

changes=0

# set_arg NAME OLD NEW: report, and rewrite "ARG NAME=..." unless dry run.
set_arg() {
  local name=$1 old=$2 new=$3
  if [ -z "$new" ]; then
    printf '  %-28s %s  (lookup failed, skipped)\n' "$name" "$old"
    return
  fi
  if [ "$old" = "$new" ]; then
    printf '  %-28s %s  (up to date)\n' "$name" "$old"
    return
  fi
  printf '* %-28s %s -> %s\n' "$name" "$old" "$new"
  changes=$((changes + 1))
  $dry_run || sed -i "s|^ARG $name=.*|ARG $name=$new|" "$dockerfile"
}

current_arg() {
  sed -n "s/^ARG $1=//p" "$dockerfile"
}

echo "Checking annotated refs in Dockerfile..."
annotation=""
while IFS= read -r line; do
  if [[ "$line" == "# renovate: "* ]]; then
    annotation=${line#"# renovate: "}
    continue
  fi
  if [[ -n "$annotation" && "$line" =~ ^ARG\ ([A-Za-z0-9_]+)=(.*)$ ]]; then
    name=${BASH_REMATCH[1]}
    old=${BASH_REMATCH[2]}
    datasource="" dep="" branch=""
    for kv in $annotation; do
      case "$kv" in
        datasource=*) datasource=${kv#*=} ;;
        depName=*) dep=${kv#*=} ;;
        branch=*) branch=${kv#*=} ;;
      esac
    done
    if wanted "$name"; then
      case "$datasource" in
        github-tags) new=$(latest_github_tag "$dep" "$old" || true) ;;
        git-refs) new=$(latest_branch_sha "$dep" "$branch" || true) ;;
        docker) new=$(latest_docker_tag "$dep" || true) ;;
        *) echo "  $name: unsupported datasource '$datasource', skipped"; new=$old ;;
      esac
      set_arg "$name" "$old" "$new"
    fi
  fi
  annotation=""
done <"$dockerfile"

# DuckDB: version and per-arch sha256 must move together. Two lines ship:
# DUCKDB_* (newest release, duckdb2) and DUCKDB1_* (newest 1.x, duckdb1 for
# CPUs without x86-64-v3). Each line keeps its own asset naming.
duckdb_releases=""

# bump_duckdb PREFIX MAJOR ASSET_TEMPLATE  (ASSET_TEMPLATE uses ARCH)
bump_duckdb() {
  local prefix=$1 major=$2 template=$3 old new release amd64 arm64
  wanted "${prefix}_VERSION" || return 0
  old=$(current_arg "${prefix}_VERSION")
  [ -n "$old" ] || return 0
  if [ -z "$duckdb_releases" ]; then
    duckdb_releases=$(github_api "repos/duckdb/duckdb/releases?per_page=100" || echo '[]')
  fi
  # Newest non-prerelease, optionally limited to one major version.
  release=$(jq -c --arg m "$major" '
    [.[] | select(.prerelease | not) | select(.draft | not)
         | select($m == "" or (.tag_name | startswith("v" + $m + ".")))]
    | sort_by(.tag_name | ltrimstr("v") | split(".") | map(tonumber? // 0))
    | last // empty' <<<"$duckdb_releases")
  new=$(jq -r '.tag_name // empty' <<<"$release" | sed 's/^v//')
  if [ -z "$new" ] || [ "$new" = "$old" ]; then
    set_arg "${prefix}_VERSION" "$old" "$new"
    return 0
  fi
  sha() {
    jq -r --arg n "${template//ARCH/$1}" \
      '.assets[] | select(.name == $n) | .digest // empty' <<<"$release" | sed 's/^sha256://'
  }
  amd64=$(sha amd64)
  arm64=$(sha arm64)
  if [ -z "$amd64" ] || [ -z "$arm64" ]; then
    printf '  %-28s %s  (%s has no %s assets;\n' "${prefix}_VERSION" "$old" "$new" "${template//ARCH/<arch>}"
    printf '  %-28s %s   asset naming changed, update the Dockerfile download step by hand)\n' "" "${old//?/ }"
    return 0
  fi
  set_arg "${prefix}_VERSION" "$old" "$new"
  set_arg "${prefix}_SHA256_AMD64" "$(current_arg "${prefix}_SHA256_AMD64")" "$amd64"
  set_arg "${prefix}_SHA256_ARM64" "$(current_arg "${prefix}_SHA256_ARM64")" "$arm64"
}

if wanted DUCKDB_VERSION || wanted DUCKDB1_VERSION; then
  echo "Checking DuckDB..."
  bump_duckdb DUCKDB "" "duckdb-cli-linux-ARCH-musl.tar.gz"
  bump_duckdb DUCKDB1 1 "duckdb_cli-linux-ARCH-musl.gz"
fi

# Keep init.lua's vim-plug auto-install URL on the Dockerfile's version.
vim_plug=$(current_arg VIM_PLUG_REF)
if ! grep -q "junegunn/vim-plug/$vim_plug/plug.vim" "$init_lua"; then
  echo "* init.lua vim-plug URL -> $vim_plug"
  changes=$((changes + 1))
  $dry_run || sed -i "s|junegunn/vim-plug/[^/]*/plug.vim|junegunn/vim-plug/$vim_plug/plug.vim|" "$init_lua"
fi

echo
if [ "$changes" -eq 0 ]; then
  echo "Everything is up to date."
elif $dry_run; then
  echo "$changes update(s) available. Re-run without --dry-run to apply."
else
  echo "$changes update(s) applied. Review with: git diff -- Dockerfile dotfiles/nvim/init.lua"
fi
