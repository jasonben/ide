#!/usr/bin/env bash

set -e

ide () {
  docker_host="tcp://dockersock:2375"
  dockersock_network="dockersock"
  ide_docker_image="${IDE_DOCKER_IMAGE:-jasonben/ide}"
  host_hostname=$(cat /etc/hostname)

  docker run -it --rm \
    --log-driver=none \
    --privileged \
    --network="$dockersock_network" \
    -e DOCKER_HOST="$docker_host" \
    --cap-add=NET_ADMIN \
    --cap-add=SYS_MODULE \
    -v jasonben_ide_bundle:/jasonben/ide/bundle \
    -v jasonben_ide_cache:/jasonben/ide/.cache \
    -v jasonben_ide_code:/jasonben/ide/code \
    -v jasonben_ide_config:/jasonben/ide/.config \
    -v jasonben_ide_local:/jasonben/ide/.local \
    -v jasonben_ide_nvim:/jasonben/ide/.nvim \
    -v jasonben_ide_ssh:/jasonben/ide/.ssh \
    -v jasonben_ide_tailscale:/var/lib \
    -v jasonben_ide_tmuxinator:/jasonben/ide/.tmuxinator \
    -v /dev/net/tun:/dev/net/tun \
    "$ide_docker_image" \
    tmux new-session -A -s "ide on $host_hostname" "$@"
}

docker_socket() {
  local network="dockersock"
  local project="docker-sock"
  local tmp_dir="/tmp/docker-sock"

  # Check if network exists, create if not
  if ! docker network ls --format '{{.Name}}' | grep -q "^${network}$"; then
    echo "Creating network: ${network}"
    docker network create "${network}" 1>/dev/null
  fi

  # Check if the compose project is already running
  if ! docker compose ls --format json 2>/dev/null | grep -q "\"${project}\""; then
    echo "Starting docker-sock compose project..."
    git clone -q https://github.com/jasonben/docker-sock.git "${tmp_dir}" && \
    pushd "${tmp_dir}" 1>/dev/null 2>/dev/null && \
    docker compose up -d 1>/dev/null 2>/dev/null && \
    popd 1>/dev/null 2>/dev/null
    rm -rf "${tmp_dir}"
  fi
}

ensure_volumes() {
  local volumes=(
    jasonben_ide_nvim
    jasonben_ide_ssh
    jasonben_ide_code
    jasonben_ide_bundle
    jasonben_ide_local
    jasonben_ide_config
    jasonben_ide_cache
    jasonben_ide_tailscale
    jasonben_ide_tmuxinator
  )

  for volume in "${volumes[@]}"; do
    docker volume create "${volume}" 1>/dev/null 2>/dev/null
  done
}

ensure_volumes
docker_socket
echo "Starting ide..."
ide "$@"
